# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blogging_platform

# Connection pool (optional)
PGPOOL_MAX=20
PGPOOL_IDLE_MS=30000
PGPOOL_CONN_TIMEOUT_MS=5000

# Client origin (CORS, passkeys, magic links)
CLIENT_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173

# JWT — access token is short-lived; refresh uses HttpOnly cookie + DB
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_DAYS=14

# Passkeys (WebAuthn)
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=BlogHub

# Caching (seconds)
FEED_CACHE_TTL_SEC=60
LIST_CACHE_TTL_SEC=120

# View count buffer flush interval (ms)
VIEW_COUNT_FLUSH_MS=20000

# Rate limits (per IP per minute)
RATE_LIMIT_SEARCH_PER_MIN=30
RATE_LIMIT_READ_PER_MIN=200

# Prometheus metrics at GET /metrics (set to 1 to enable)
ENABLE_METRICS=0
